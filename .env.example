# Mini Vault environment example

# Storage paths
MINI_VAULT_DATA_DIR=data
MINI_VAULT_LOG_DIR=data/logs
MINI_VAULT_VAULT_FILE=vault.json
MINI_VAULT_USERS_FILE=users.json
MINI_VAULT_KV_FILE=kv_secrets.json
MINI_VAULT_TRANSIT_FILE=transit_keys.json

# Session settings
SESSION_TTL_MINUTES=30
ACCOUNT_LOCKOUT_MINUTES=5
